{
  "training_cost_required_fields": [
    "model",
    "training_run_id",
    "seed",
    "parameter_count",
    "epochs",
    "optimizer_steps",
    "wall_seconds",
    "peak_rss_mb",
    "device",
    "final_training_loss",
    "final_validation_loss"
